# Copy to .env.production. Use a real hostname with DNS pointing to the server.
# Before deployment, run: node scripts/preflight.cjs .env.production
APP_DOMAIN=sheet.example.com
ACME_EMAIL=admin@example.com
RELEASE_TAG=2026-09-28
# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hex passwords also avoid URL-escaping issues in DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
