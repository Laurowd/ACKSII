# Copy to .env.neon.production and fill on the deployment host.
# Validate: node scripts/preflight.cjs .env.neon.production --neon
APP_DOMAIN=sheet.example.com
ACME_EMAIL=admin@example.com
RELEASE_TAG=2026.10.01-1
# Copy both URLs from the same branch/database/role in the Neon console.
# DATABASE_URL: Connection pooling enabled; keep sslmode=require.
DATABASE_URL=
# DIRECT_DATABASE_URL: Connection pooling disabled; keep sslmode=require.
DIRECT_DATABASE_URL=
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
