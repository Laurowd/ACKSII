# Backend environment variables
# Copy this file to .env and adjust as needed.

JWT_SECRET=change-this-in-development
PORT=3001
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development
# Comma-separated trusted proxy IPs/CIDRs. Empty means direct connections only.
TRUST_PROXY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acks2
