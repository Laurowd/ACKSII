# Configure these variables in the Vercel project settings. Never use VITE_
# for credentials: VITE_ variables are embedded in the public frontend.
# Validate a local copy: node scripts/preflight.cjs .env.vercel --vercel
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=https://YOUR-PROJECT.vercel.app
PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
